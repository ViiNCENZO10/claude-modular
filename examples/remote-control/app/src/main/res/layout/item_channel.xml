<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:focusable="true"
    android:duplicateParentState="true">

    <!-- Barre verticale d'accent doré pour la chaîne en cours de diffusion -->
    <View
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/channel_item_accent"
        android:duplicateParentState="true" />

    <TextView
        android:id="@+id/channel_num"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:textColor="@color/channel_text_secondary"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:gravity="end"
        android:paddingEnd="10dp"
        android:duplicateParentState="true" />

    <TextView
        android:id="@+id/channel_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/channel_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:duplicateParentState="true" />

    <TextView
        android:id="@+id/channel_now"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/channel_text_secondary"
        android:textSize="11sp"
        android:maxWidth="120dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingEnd="12dp"
        android:duplicateParentState="true" />

</LinearLayout>
