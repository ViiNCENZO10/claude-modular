<?xml version="1.0" encoding="utf-8"?>
<!--
    Surbrillance des lignes dans la sidebar chaînes/groupes.
    - focused / pressed / selected = pastille blanche bien visible (où on est)
    - activated = pastille dorée semi-transparente (chaîne actuellement diffusée)
    L'ordre des items compte : focused doit gagner sur activated (sinon en remontant la liste
    on perd la surbrillance de focus sur la chaîne en cours).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focus en cours via D-pad : surbrillance blanche FORTE -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#f5ffffff" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Pressé (clic) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#ffffffff" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Sélectionné (touch ou setSelection) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#e6ffffff" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Chaîne actuellement diffusée (CHOICE_MODE_SINGLE + setItemChecked) -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#33ffd700" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#80ffd700" />
        </shape>
    </item>

    <!-- État par défaut : transparent -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
